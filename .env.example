# ==============================================================================
# LegalConnect — Environment Configuration Template
# Copy this file to .env and customize as needed: cp .env.example .env
# ==============================================================================

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIR=vectorstore/chroma
CHROMA_COLLECTION=legal_bns_2023

# SentenceTransformers Embedding Model
# Offline cached model: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# LLM Provider Configuration
# Supported providers: 'ollama' (default for local development) or 'openai_compatible' (for hosted models)
LLM_PROVIDER=ollama

# Local LLM Inference Engine (Ollama)
# For local machine: http://127.0.0.1:11434
# For Docker container reaching host Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b

# Hosted LLM Inference Engine (optional, when LLM_PROVIDER=openai_compatible)
# Examples:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.1-8b-instant
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1,   LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_hosted_api_key_here

# FastAPI Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Streamlit Frontend Service
# Points to the FastAPI backend API
BACKEND_API_URL=http://127.0.0.1:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
